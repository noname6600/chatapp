{
  "__inputs": [
    {
      "name": "chatapp-prometheus",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Kafka broker, topic, and consumer group metrics via kafka-exporter",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "kafka_brokers",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Brokers Online",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "count(kafka_topic_partitions)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Topics",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "sum(kafka_consumergroup_lag)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Total Consumer Lag",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "count(kafka_consumergroup_members)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Consumer Groups",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 100,
      "title": "Consumer Group Lag",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "sum(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"}) by (consumergroup)",
          "legendFormat": "{{consumergroup}}",
          "refId": "A"
        }
      ],
      "title": "Consumer Group Lag (total per group)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "kafka_consumergroup_lag{consumergroup=~\"$consumergroup\", topic=~\"$topic\"}",
          "legendFormat": "{{consumergroup}} | {{topic}} | p{{partition}}",
          "refId": "A"
        }
      ],
      "title": "Consumer Group Lag per Topic / Partition",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Lag" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 100 },
                    { "color": "red", "value": 1000 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "id": 7,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Lag" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "kafka_consumergroup_lag",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Consumer Lag Table (all groups)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": {
              "consumergroup": "Consumer Group",
              "topic": "Topic",
              "partition": "Partition",
              "Value": "Lag"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 101,
      "title": "Topics & Offsets",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "rate(kafka_topic_partition_current_offset{topic=~\"$topic\"}[1m])",
          "legendFormat": "{{topic}} p{{partition}}",
          "refId": "A"
        }
      ],
      "title": "Topic Message Rate (msgs/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 9,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Topic" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "kafka_topic_partitions",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Topic Partition Count",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "topic": "Topic", "Value": "Partitions" }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 102,
      "title": "Under-Replicated & Leader Issues",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "sum(kafka_topic_partition_under_replicated_partition) by (topic)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "Under-Replicated Partitions (should be 0)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "sum(kafka_topic_partition_in_sync_replica) by (topic)",
          "legendFormat": "{{topic}} in-sync",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
          "expr": "sum(kafka_topic_partition_replicas) by (topic)",
          "legendFormat": "{{topic}} total replicas",
          "refId": "B"
        }
      ],
      "title": "In-Sync vs Total Replicas",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["kafka", "chatapp"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
        "definition": "label_values(kafka_consumergroup_lag, consumergroup)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "consumergroup",
        "options": [],
        "query": {
          "query": "label_values(kafka_consumergroup_lag, consumergroup)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Consumer Group"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${chatapp-prometheus}" },
        "definition": "label_values(kafka_topic_partitions, topic)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "topic",
        "options": [],
        "query": {
          "query": "label_values(kafka_topic_partitions, topic)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Topic"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Kafka Overview",
  "uid": "chatapp-kafka-overview",
  "version": 1
}
